# Zoho (US data centre, org 677567221)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_ORG_ID=677567221

# Zoho Billing: prices, coupons, hosted pages (scope ZohoSubscriptions.fullaccess.all)
ZOHO_BILLING_CLIENT_ID=
ZOHO_BILLING_CLIENT_SECRET=
ZOHO_BILLING_REFRESH_TOKEN=
# true = create real Zoho hosted pages at checkout
ZOHO_CHECKOUT_ENABLED=false

# Zoho CRM leads (home form + abandoned checkout)
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_LEADS_REFRESH_TOKEN=
ZOHO_CRM_LEADS_ENABLED=false

# Loqate / PostcodeAnywhere
LOQATE_CAPTURE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false

# Local UI work without calling Zoho (uses src/data/zoho-price-snapshot.json)
# ZOHO_OFFLINE=true
